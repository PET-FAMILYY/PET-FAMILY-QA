    {
      "name": "Agendamento",
      "item": [
        {
          "name": "Post - Agendar Consulta",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "var offset = Math.floor(Math.random() * 900) + 100;",
                  "var data = new Date();",
                  "data.setDate(data.getDate() + offset);",
                  "var ano = data.getFullYear();",
                  "var mes = String(data.getMonth() + 1).padStart(2, '0');",
                  "var dia = String(data.getDate()).padStart(2, '0');",
                  "pm.environment.set(\"dataConsulta\", ano + \"-\" + mes + \"-\" + dia);"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test(\"Consulta criada com status AGENDADA\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.status).to.equal(\"AGENDADA\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"petId\": 1,\r\n  \"tipoConsulta\": \"Vacinação\",\r\n  \"data\": \"{{dataConsulta}}\",\r\n  \"horario\": \"14:00\"\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseURL}}/consultas/agendar",
              "host": ["{{baseURL}}"],
              "path": ["consultas", "agendar"]
            }
          },
          "response": []
        },
